{
  "appId": "app.ahdaf.scores",
  "appName": "أهداف",
  "webDir": "public",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "GoogleAuth": {
      "scopes": ["profile", "email", "https://www.googleapis.com/auth/drive.appdata"],
      "serverClientId": "",
      "forceCodeForRefreshToken": true
    },
    "SplashScreen": {
      "launchShowDuration": 0
    }
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#000000"
  }
}
